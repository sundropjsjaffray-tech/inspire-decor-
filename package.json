{
  "name": "team-site-template",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local node_modules/vite/bin/vite.js dev",
    "build": "vite build",
    "preview": "node --env-file-if-exists=.env.local node_modules/vite/bin/vite.js preview --host 0.0.0.0 --port 4174",
    "start": "bun run serve.ts",
    "publish": "bash ./publish.sh",
    "go-live": "bash ./go-live.sh",
    "format": "prettier --write .",
    "db:migrate": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/migrate-inventory.ts",
    "db:seed": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/seed-inventory.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-start": "^1.168.54",
    "jspdf": "^4.2.1",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.5"
  },
  "allowScripts": {
    "esbuild": true
  }
}
